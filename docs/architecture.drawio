<diagram id="page2" name="Agents"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Agents: one general agent, one agent per class&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Class agents own everything about one class. The general agent routes to them (AGENTS_V2.md)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="20" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="10" width="230" height="150" as="geometry" /></mxCell><mxCell id="c5" value="Deployed: green solid border" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="40" width="200" height="30" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Student (web or app)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Today chat, Study tab, class pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="70" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;General agent (Chief of Staff)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;briefing, day plan, cross-class questions; /chat/master&lt;/font&gt;&lt;br&gt;&lt;font style