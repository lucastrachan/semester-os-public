<diagram id="page3" name="Auto-campus and auth"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Auto-campus: a verified .edu email creates the school&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="c3" value="No campus requests: any .edu is accepted, known schools get verified colours, unknown ones get detected colours." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1200" height="20" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="10" width="230" height="150" as="geometry" /></mxCell><mxCell id="c5" value="Deployed: green solid border" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="40" width="200" height="30" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;1. Email at sign-up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;student web or app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;2. pre_signup trigger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;free mail rejected; .edu last two labels; demo account bypass; blocked domains&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="240" height="90" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;3. Cognito email code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;proves control of the address&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;4. First /me call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;creates campus once (conditional put) + profile; accepts device time zone&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="240" height="90" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;5. Campus page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;themed school page, then Study tab&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Demo accounts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DEMOACCT# maps a fixed email to a campus; made in admin site&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="240" height="80" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;School registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;us_schools.json: official name, domains&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="220" height="80" as="geometry" /></mxCell><mxCell id="c19" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c17" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c18" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;GET /public/resolve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;domain -&amp;gt; school name + colours while typing; rate limited&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="80" as="geometry" /></mxCell><mxCell id="c22" value="themes sign-up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c21" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Verified colour table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;school_colors.json from official sources, used first&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="240" height="80" as="geometry" /></mxCell><mxCell id="c24" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Placeholder palette&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hash of name -&amp;gt; curated AA colour; also fallback&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="220" height="80" as="geometry" /></mxCell><mxCell id="c26" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;Colour worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;async; fetches only the school homepage via safe_fetch; model picks colour; code validates hex and contrast&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="450" width="240" height="100" as="geometry" /></mxCell><mxCell id="c28" value="async, once per campus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c11" target="c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;safe_fetch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;https only, public IPs, size cap, same-domain redirects&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="220" height="80" as="geometry" /></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;Nova Lite / GLM-5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;page text wrapped as untrusted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="450" width="220" height="80" as="geometry" /></mxCell><mxCell id="c32" value="choose colour" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;colorStatus: needs_review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;detected colour, source, confidence; placeholder if it failed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="620" width="240" height="80" as="geometry" /></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;Admin review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ColorReview tab: approve or set hex (validated server-side), audit entry&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="620" width="220" height="80" as="geometry" /></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TENANTS, DOMAIN#, USER# profile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="220" height="80" as="geometry" /></mxCell><mxCell id="c38" value="saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c33" target="c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="&lt;b&gt;Rejected: non-.edu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;friendly message, no campus created&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="450" width="240" height="70" as="geometry" /></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c9" target="c41"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page4" name="Security layers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Security in layers (SECURITY.md)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Model and user text is untrusted data; tools only through the gate; users only see their own rows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="20" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="10" width="230" height="150" as="geometry" /></mxCell><mxCell id="c5" value="Deployed: green solid border" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="40" width="200" height="30" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;1  Edge&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="100" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;CloudFront headers: CSP, HSTS, no framing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin site live; student-site headers pending&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="370" height="100" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;API Gateway: CORS, no ANY on protected routes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OPTIONS never hits the authorizer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="370" height="100" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;2  Identity&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="190" height="100" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;Student JWT authorizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;issuer + client of the student pool&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="220" width="370" height="100" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Staff JWT authorizer + admins group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;separate pool; API re-checks issuer and group; fails closed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="370" height="100" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;TOTP MFA on staff pool, OAuth off&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no public admin sign-up&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="370" height="100" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;3  Request limits&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="190" height="100" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Per-user daily caps and size caps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;limits.py: atomic counters with ttl&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="340" width="370" height="100" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;AI kill switch + output token caps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;limits.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="340" width="370" height="100" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;S3 upload: PDF only, 10 MB, presigned POST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;5 minute link&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="370" height="100" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;4  Data isolation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="190" height="100" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;UserScopedDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;keys built from the token's sub; model ids never pick a row&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="460" width="370" height="100" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Transactions with conditions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;campus create, admin change + audit item both or neither&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="460" width="370" height="100" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Campus and user come from the token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;never from the request body&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="370" height="100" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;5  Model safety&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="190" height="100" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Untrusted-data wrapping with nonce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;guard.wrap_untrusted + data_rules&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="580" width="370" height="100" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Tool gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validate_tool_call: allow-list, schema, own course, budget, Undo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="580" width="370" height="100" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;Output sanitiser, plain text only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no HTML, no remote images, safe links only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="370" height="100" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;6  Network and secrets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="190" height="100" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;safe_fetch (SSRF-safe)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;used by colour worker and feed sync&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="700" width="370" height="100" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;secretbox + KMS for feed URLs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;feed URLs encrypted with the KMS key&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="700" width="370" height="100" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;Calendar feed token rotation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /me/calendar-token/rotate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="700" width="370" height="100" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;7  Logging&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="190" height="100" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;redact() on logs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strips tokens, emails, secret URLs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="820" width="370" height="100" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Admin audit log ADMIN_AUDIT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;90 day ttl, includes admin.denied&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="820" width="370" height="100" as="geometry" /></mxCell><mxCell id="c35" value="&lt;b&gt;Reports, bans, listing chat moderation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin routes live&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="820" width="370" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page5" name="Data model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;DynamoDB single table: AppTable (pk, sk, gsi1, gsi2, ttl)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry" /></mxCell><mxCell id="c3" value="Items below are what the code writes. Status = whether the code path is live." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="20" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="10" width="230" height="150" as="geometry" /></mxCell><mxCell id="c5" value="Deployed: green solid border" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="40" width="200" height="30" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Tenancy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="40" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;TENANTS / T#{tenantId}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;campus: name, domains, theme, timezone, lms, categories, colorStatus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="320" height="100" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;DOMAIN#{root} / MAP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;domain -&amp;gt; tenantId (written with attribute_not_exists)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="320" height="100" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;BLOCKED_DOMAINS / D#{domain}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin kill switch for abuse&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="320" height="100" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;DEMOACCT#{email} / MAP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;demo account -&amp;gt; campus; hashed registry under DEMOACCTS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="320" height="100" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;BANNED_USERS / U#{sub}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin ban, checked by /me and chat&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="320" height="100" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Student&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="385" y="100" width="320" height="40" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;USER#{sub} / PROFILE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;email, tenantId, calToken, prefs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="160" width="320" height="100" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;USER#{sub} / COURSE#{courseId}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;class agent: syllabus facts, status, colour&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="275" width="320" height="100" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;USER#{sub} / ASG#{courseId}#{id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;assignments and deadlines&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="390" width="320" height="100" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;USER#{sub} / ACT#{ts}#{id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;activity feed (handoffs, actions)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="505" width="320" height="100" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;CAL#{token} / MAP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;secret calendar token -&amp;gt; sub&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="620" width="320" height="100" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Chat and memory&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="320" height="40" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;USER#{sub} / CHAT#{courseId}#{ts}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;history with ttl; CHATMETA# holds rolling summary&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="160" width="320" height="100" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;USER#{sub} / MEM#{courseId}#{id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;short notes the agent keeps; MAT# and CHUNK# hold materials&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="275" width="320" height="100" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;FEEDUSER#{shard} / U#{sub}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;which students have a feed, for the sync job&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="390" width="320" height="100" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;USER#{sub} / FEED#...&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;feed events, rules, stats (feed_api)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="505" width="320" height="100" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Marketplace&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1075" y="100" width="320" height="40" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;LISTING#{id} / META&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;listing; gsi1 TENANT#{id}#LISTINGS by time; gsi2 ISBN# for book matches&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="160" width="320" height="100" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;LISTING#{id} / REPORT#{hash}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reports on a listing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="275" width="320" height="100" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;CONVO#{cid} / META + messages&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;listing chat, ttl; USER#/CONV# is each side's inbox&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="390" width="320" height="100" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;USER#{sub} / BLOCK#{hash}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;block another user&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="505" width="320" height="100" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;REPORTS / {kind}#...&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;moderation queue read by admin&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="620" width="320" height="100" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;Operations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1420" y="100" width="320" height="40" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;ADMIN_AUDIT / {ISO}#{id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin actions, 90 day ttl, same transaction as the change&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="160" width="320" height="100" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;USER#{sub} / LIMIT#{scope}#{window}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rate and daily-cap counters, ttl; IP#{hash} for public routes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;DEPLOYED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="275" width="320" height="100" as="geometry" /></mxCell><mxCell id="c34" value="GSIs: gsi1 (gsi1pk, gsi1sk) lists a campus's listings; gsi2 (gsi2pk, gsi2sk) finds listings by ISBN across campuses. Every student read goes through UserScopedDB, so a USER# partition other than the caller's is unreachable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1500" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>